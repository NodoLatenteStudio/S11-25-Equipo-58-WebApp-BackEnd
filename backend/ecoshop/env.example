# ============================================
# CONFIGURACIÓN DE CLERK
# ============================================
# Obtén estas claves desde: https://dashboard.clerk.com
# Ve a tu aplicación > API Keys

# Secret Key de Clerk (sk_test_xxxxx o sk_live_xxxxx)
# Se usa para validar tokens JWT y autenticar webhooks
CLERK_SECRET_KEY=

# Publishable Key de Clerk (pk_test_xxxxx o pk_live_xxxxx)
# Se usa principalmente en el frontend, pero puede ser útil en el backend
CLERK_PUBLISHABLE_KEY=

# Issuer de Clerk (https://your-instance.clerk.accounts.dev)
# URL base de tu instancia de Clerk
# Se usa para validar que los tokens JWT fueron emitidos por Clerk
CLERK_ISSUER=

# Webhook Secret de Clerk (whsec_xxxxx)
# Se obtiene al configurar webhooks en Clerk Dashboard
# Se usa para verificar que los webhooks realmente provienen de Clerk
CLERK_WEBHOOK_SECRET=

# URL de la API de Clerk (opcional, por defecto: https://api.clerk.com)
# Según Clerk Dashboard, la Backend API URL es: https://api.clerk.com
# Los endpoints se agregan directamente (ej: /users, /sessions, etc.)
CLERK_API_URL=https://api.clerk.com

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
# NOTA: Puerto 5433 por defecto para evitar conflicto con PostgreSQL local
# Si usas Docker Compose, el puerto está mapeado a 5433
DB_URL=jdbc:postgresql://localhost:5433/ecoshop
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ============================================
# CONFIGURACIÓN DE SPRING
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Configuración de JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Configuración de Logging
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN

# ============================================
# CONFIGURACIÓN DE PASARELAS DE PAGO
# ============================================
# Ver INSTRUCCIONES-PASARELAS-PAGO.md para obtener estas claves

# Stripe
# Obtén estas claves desde: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# PayPal
# Obtén estas claves desde: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # o "live" para producción

# MercadoPago
# Obtén estas claves desde: https://www.mercadopago.com/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

